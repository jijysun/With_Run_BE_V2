# =====================================================================
# .env 예시 — 실제 값을 채워 .env 로 저장 (절대 커밋 금지)
# 운영 배포용은 이 내용 그대로 GitHub Secret `ENV_FILE` 에 넣는다.
# (단, 아래 LOADTEST_SEED_ENABLED는 운영 시크릿엔 반드시 false로 — 로컬 값 그대로 복사 금지!)
# APP_IMAGE는 여기 넣지 않는다 — deploy.yml이 배포 시점에 커밋 SHA로 자동 주입한다.
# =====================================================================

# === Database (RDS, 2026-07-24 확정) ===
# DB_HOST에 RDS 엔드포인트 DNS 호스트명을 직접 넣는다(IP 캐싱 금지 — 장애조치 시 바뀔 수 있음).
# 예: DB_HOST=withrun-db.xxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
# RDS는 "퍼블릭 액세스: 아니오" + 보안그룹을 EC2 인스턴스로만 제한할 것.
DB_NAME=withrun
DB_USERNAME=withrun
DB_PASSWORD=change-me
DB_HOST=change-me-rds-endpoint
DB_PORT=3306

# 컨테이너 안에서는 compose가 REDIS_HOST=redis 로 덮어쓴다(로컬 IDE 직접 실행 시엔 아래 값 사용).
REDIS_HOST=localhost
REDIS_PORT=6379

# === JWT ===
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION=3600000

# === Discord ===
# 배포 성공/실패 알림(GitHub Actions)과 앱 자체의 신고 알림이 같은 웹훅 URL을 공유해서 쓴다.
DISCORD_WEBHOOK_URL=

# === 채팅 부하테스트 시드 러너 ===
# 로컬 부하테스트 때만 true. 운영(ENV_FILE 시크릿)에는 반드시 false — 배포마다 가짜 유저가 시딩됨!
LOADTEST_SEED_ENABLED=false
# 시딩할 유저 수(4의 배수 권장 — ROOM_CAPACITY=4로 나눠 떨어져야 방이 딱 맞게 채워짐)
LOADTEST_SEED_USER_COUNT=500

# === Grafana 관리자 비밀번호 (필수, 기본값 없음 — admin/admin 방치 금지) ===
GRAFANA_PASSWORD=

# === 채팅 서비스 범위 외 — 미설정 시 빈 값으로 부팅됨 (필요해지면 주석 해제) ===
#S3_BUCKET=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#GOOGLE_API_KEY=
#AI_API_URI=
#AI_API_KEY=
