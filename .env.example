# =====================================================================
# .env 예시 — 실제 값을 채워 .env 로 저장 (절대 커밋 금지)
# 운영 배포용은 이 내용 그대로 GitHub Secret `ENV_FILE` 에 넣는다.
# =====================================================================

# === Database (docker-compose가 mysql 컨테이너 초기화에도 사용) ===
DB_NAME=withrun
DB_USERNAME=withrun
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# 로컬(IDE)에서 직접 실행할 때 사용하는 접속 정보.
# 컨테이너 안에서는 compose가 DB_HOST=mysql, REDIS_HOST=redis 로 덮어쓴다.
DB_HOST=localhost
DB_PORT=3306
REDIS_HOST=localhost
REDIS_PORT=6379

# === JWT ===
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION=3600000

# === Discord (신고 알림 — 배포 알림은 GitHub Secret 쪽 사용) ===
DISCORD_WEBHOOK_URL=

# === 채팅 부하테스트 시드 러너 — 로컬 부하테스트 때만 true, 운영에서는 절대 켜지 말 것 ===
LOADTEST_SEED_ENABLED=false
# 시딩할 유저 수(4의 배수 권장 — ROOM_CAPACITY=4로 나눠 떨어져야 방이 딱 맞게 채워짐)
LOADTEST_SEED_USER_COUNT=500

# === Grafana 관리자 비밀번호 (필수, 기본값 없음 — admin/admin 방치 금지) ===
GRAFANA_PASSWORD=

# === 채팅 서비스 범위 외 — 미설정 시 빈 값으로 부팅됨 (필요해지면 주석 해제) ===
#S3_BUCKET=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#GOOGLE_API_KEY=
#AI_API_URI=
#AI_API_KEY=
